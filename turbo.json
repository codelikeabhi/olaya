{
  "$schema": "https://v2-8-13.turborepo.dev/schema.json",
  "globalEnv": [
    "CI",
    "OLAYA_DISABLE_SHARE"
  ],
  "globalPassThroughEnv": [
    "CI",
    "OLAYA_DISABLE_SHARE"
  ],
  "tasks": {
    "typecheck": {},
    "build": {
      "dependsOn": [],
      "outputs": [
        "dist/**"
      ]
    },
    "olaya#test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [],
      "passThroughEnv": [
        "*"
      ]
    },
    "@olaya/core#test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "@olaya/app#test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "@olaya/ui#test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "@olaya/session-ui#test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    }
  }
}
